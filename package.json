{
  "name": "financial-copilot",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:models": "vitest run --config scripts/check-models.config.ts",
    "verify": "npm run lint && npm run check:architecture && npm run typecheck && npm test && npm run test:e2e",
    "fixtures:sc001": "node e2e/support/write-sc001.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
